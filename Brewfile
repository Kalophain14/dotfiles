# =============================================================
# BREWFILE — restore your full setup on a new Mac
# Usage: brew bundle
# =============================================================

# ── TAPS ────────────────────────────────────────────────────
tap "homebrew/cask-fonts"

# ── SHELL & TERMINAL ────────────────────────────────────────
brew "zsh"
brew "stow"                  # Dotfile symlink manager
brew "starship"              # (backup prompt if p10k breaks)
cask "ghostty"               # Terminal

# ── ZSH PLUGINS ─────────────────────────────────────────────
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"

# ── SHELL TOOLS ─────────────────────────────────────────────
brew "eza"                   # Better ls
brew "bat"                   # Better cat
brew "fzf"                   # Fuzzy finder
brew "fd"                    # Better find
brew "zoxide"                # Smarter cd
brew "ripgrep"               # Better grep
brew "direnv"                # Per-directory env vars
brew "thefuck"               # Auto-correct mistyped commands
brew "tldr"                  # Simpler man pages
brew "btop"                  # Better top/htop

# ── GIT ─────────────────────────────────────────────────────
brew "git"
brew "delta"                 # Better git diff
brew "lazygit"               # Git TUI
brew "gh"                    # GitHub CLI

# ── EDITORS ─────────────────────────────────────────────────
brew "helix"                 # Modal terminal editor
cask "visual-studio-code"

# ── JAVA / SPRING BOOT ──────────────────────────────────────
cask "corretto@17"           # Amazon Corretto JDK 17
brew "maven"

# ── NODE ────────────────────────────────────────────────────
brew "nvm"

# ── DOCKER ──────────────────────────────────────────────────
cask "docker"
brew "lazydocker"            # Docker TUI

# ── DATABASES ───────────────────────────────────────────────
brew "postgresql@16"
brew "redis"

# ── HTTP / API ───────────────────────────────────────────────
brew "httpie"                # Friendly HTTP client
brew "jq"                    # JSON processor

# ── FONTS ───────────────────────────────────────────────────
cask "font-jetbrains-mono-nerd-font"
