# FONT
font-family = "JetBrains Mono"
font-size = 13
font-thicken = false

# THEME & COLORS
theme = catppuccin-mocha
background-opacity = 0.75
background-blur-radius = 10

# WINDOW
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = hidden
window-save-state = always

# CURSOR
cursor-style = bar
cursor-style-blink = true

# SCROLLBACK
scrollback-limit = 10000

# TABS & SPLITS
macos-option-as-alt = true

# KEYBINDINGS
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+t=new_tab
keybind = cmd+shift+w=close_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = global:cmd+grave_accent=toggle_quick_terminal

# QUICK TERMINAL
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# PERFORMANCE
resize-overlay = never
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
keybind = shift+enter=text:\x1b\r
